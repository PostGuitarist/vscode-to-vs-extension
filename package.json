{
  "name": "vscode-to-vs",
  "displayName": "VSCode to Visual Studio",
  "publisher": "PostGuitarist",
  "description": "Generate Visual Studio C++ solution and project files from a folder of source files.",
  "author": {
    "name": "Zaden Connell"
  },
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/vsicon.png",
  "pricing": "Free",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PostGuitarist/vscode-to-vs-extension.git"
  },
  "bugs": {
    "url": "https://github.com/PostGuitarist/vscode-to-vs-extension/issues"
  },
  "keywords": [
    "vscode",
    "vs",
    "visual",
    "studio",
    "code",
    "cpp",
    "c++",
    "solution",
    "project",
    "files",
    "generate",
    "create",
    "extension"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-to-vs.generateCppSolution",
        "title": "Generate C++ Solution Files",
        "category": "VSCode to Visual Studio"
      }
    ],
    "configuration": {
      "title": "VSCode to Visual Studio",
      "properties": {
        "vscodeToVs.sourceFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".c",
            ".cc",
            ".cpp",
            ".cxx",
            ".c++"
          ],
          "markdownDescription": "File extensions collected as `<ClCompile>` source files. A leading dot is optional and matching is case-insensitive."
        },
        "vscodeToVs.headerFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".h",
            ".hh",
            ".hpp",
            ".hxx",
            ".h++",
            ".inl"
          ],
          "markdownDescription": "File extensions collected as `<ClInclude>` headers. A leading dot is optional and matching is case-insensitive."
        },
        "vscodeToVs.textFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".txt",
            ".dat"
          ],
          "markdownDescription": "File extensions collected as `<Text>` items, for data files a program reads at run time."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p .",
    "watch-tests": "tsc -p . -w",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "~1.92.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  }
}
