.vscode/**
.vscode-test/**
.vscode-test.mjs
assets/**
coverage/**
node_modules/**
out/**
src/**
.gitignore
.prettierignore
.prettierrc.json
eslint.config.mjs
vitest.config.mts
webpack.config.js
**/tsconfig.json
**/*.map
**/*.ts
